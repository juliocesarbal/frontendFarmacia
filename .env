# ==========================================================
# Variables de entorno - Frontend Farmacia (Angular)
# Angular no lee .env en tiempo de ejecucion: la URL de la API se define en
# src/environments/environment*.ts. Este archivo queda como referencia /
# documentacion del valor a usar. Rellena si tu API corre en otra URL.
# ==========================================================

API_URL=http://localhost:8000/api
