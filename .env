# ==========================================================
# Variables de entorno - Frontend Farmacia (Angular)
# set-env.js lee este archivo y genera src/environments/environment*.ts
# antes de "npm start" y "npm run build" (ver scripts prestart/prebuild).
# Cambia API_URL aqui y la app la consume. En Vercel puedes setear la
# variable API_URL en el panel (tiene prioridad sobre este archivo).
# ==========================================================

API_URL=http://localhost:8000/api
